<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Folio" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/folio_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The extension-built settings screen for a source follows Folio's light or dark, not the system's. -->
    <style name="ThemeOverlay.Folio.SourcePrefs.Dark" parent="ThemeOverlay.AppCompat.Dark" />
    <style name="ThemeOverlay.Folio.SourcePrefs.Light" parent="ThemeOverlay.AppCompat.Light" />
</resources>
